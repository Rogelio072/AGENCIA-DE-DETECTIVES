        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass Ubicacion {\n  - codigo: String\n  - nombre: String\n  - direccion: String\n  - nivelRiesgo: int\n  - estado: String\n  + Ubicacion(codigo: String, nombre: String, direccion: String, nivelRiesgo: int, estado: String)\n  + getCodigo(): String\n  + getNombre(): String\n  + getDireccion(): String\n  + getNivelRiesgo(): int\n  + setNivelRiesgo(nivelRiesgo: int): void\n  + getEstado(): String\n  + setEstado(estado: String): void\n  + toString(): String\n}\n\nclass Pista {\n  - codigo: String\n  - descripcion: String\n  - tipoEvidencia: String\n  - nivelImportancia: int\n  - nivelConfiabilidad: int\n  + Pista(codigo: String, descripcion: String, tipoEvidencia: String, nivelImportancia: int, nivelConfiabilidad: int)\n  + getCodigo(): String\n  + getDescripcion(): String\n  + setDescripcion(descripcion: String): void\n  + getTipoEvidencia(): String\n  + setTipoEvidencia(tipoEvidencia: String): void\n  + getNivelImportancia(): int\n  + getNivelConfiabilidad(): int\n  + setNiveles(nivelImportancia: int, nivelConfiabilidad: int): void\n  + toString(): String\n}\n\nclass Caso {\n  - nombreCaso: String\n  - codigoIdentificacion: String\n  - detectiveResponsable: String\n  - ubicaciones: Ubicacion[]\n  - pistas: ArrayList&lt;Pista&gt;\n  + Caso(nombreCaso: String, codigoIdentificacion: String, detectiveResponsable: String)\n  + registrarUbicacion(posicion: int, ub: Ubicacion): void\n  + consultarUbicacion(posicion: int): Ubicacion\n  + modificarUbicacion(posicion: int, nuevoRiesgo: int, nuevoEstado: String): void\n  + descartarUbicacion(posicion: int): void\n  + registrarPista(pista: Pista): void\n  + buscarPista(codigo: String): Pista\n  + modificarPista(codigo: String, desc: String, tipo: String, imp: int, conf: int): void\n  + eliminarPista(codigo: String): void\n  + cantidadUbicacionesRegistradas(): int\n  + cantidadEspaciosDisponibles(): int\n  + ubicacionMayorRiesgo(): Ubicacion\n  + pistaMayorImportancia(): Pista\n  + pistaMayorConfiabilidad(): Pista\n  + promedioImportanciaPistas(): double\n}\n\nclass Main {\n  + main(args: String[]): void\n}\n\nCaso \&quot;1\&quot; o-- \&quot;5\&quot; Ubicacion : contiene\nCaso \&quot;1\&quot; o-- \&quot;*\&quot; Pista : contiene\nMain ..&gt; Caso : usa\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5RH64qxQm2rqmZK5obzL-63">
